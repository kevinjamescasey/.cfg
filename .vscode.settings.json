{
  "editor.formatOnSave": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "codeium.enableConfig": {
    "*": true
  },
  "editor.inlineSuggest.suppressSuggestions": true,
  "codyPlusPlus.excludedFolders": [
    "node_modules",
    ".git",
    ".venv",
    ".pytest_cache"
  ],
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "window.confirmSaveUntitledWorkspace": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "files.associations": {
    "*.template": "yaml"
  },

  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "files.autoSave": "onFocusChange",
  "github.copilot.nextEditSuggestions.enabled": true,
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "csharp.suppressDotnetInstallWarning": true,
  "aws.telemetry": false,
  "git.blame.editorDecoration.enabled": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "chat.mcp.serverSampling": {
    "Global in Code: playwright": {
      "allowedModels": [
        "github.copilot-chat/claude-sonnet-4",
        "github.copilot-chat/gpt-4.1",
        "github.copilot-chat/claude-3.5-sonnet",
        "github.copilot-chat/claude-3.7-sonnet",
        "github.copilot-chat/claude-3.7-sonnet-thought",
        "github.copilot-chat/gemini-2.0-flash-001",
        "github.copilot-chat/gemini-2.5-pro",
        "github.copilot-chat/gpt-4o",
        "github.copilot-chat/o3-mini",
        "github.copilot-chat/o4-mini"
      ]
    }
  },
  "diffEditor.renderSideBySide": true,
  "chat.mcp.autostart": "newAndOutdated",
  "redhat.telemetry.enabled": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/*.log": true
  },
  "python.analysis.typeCheckingMode": "basic",
  "aws.cloudformation.telemetry.enabled": false,
  "claudeCode.preferredLocation": "panel",
  "chat.tools.terminal.autoApprove": {
    "gamechanger": true
  },
  "git.blame.statusBarItem.enabled": true,
  "[markdown]": {
    "diffEditor.ignoreTrimWhitespace": true
  },
  "dotnetAcquisitionExtension.sharedExistingDotnetPath": "/usr/local/share/dotnet/dotnet",
  "update.mode": "start",
  "editor.renderWhitespace": "all",
  "chat.agent.maxRequests": 100,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,conflictResolution,vscode-local-history}:/**/*.tc.json": "default",
    "{git,gitlens,conflictResolution,vscode-local-history}:/**/*.{asl.json,asl.yaml,asl.yml}": "default",
    "*.png": "imagePreview.previewEditor"
  },
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/lambda_function": true,
    "https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/lb": true,
    "https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/acm_certificate_validation": true,
    "https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/cloudwatch_event_rule": true
  },
  "claudeCode.disableLoginPrompt": true,
  "chat.viewSessions.orientation": "stacked"
}
